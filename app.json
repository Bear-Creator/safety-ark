{
  "expo": {
    "name": "SafetyArk",
    "slug": "safetyark",
    "version": "1.0.0",
    "scheme": "safetyark",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-contacts",
      "expo-haptics"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.anonymous.safetyark"
    },
    "ios": {
      "infoPlist": {
        "NSContactsUsageDescription": "SafetyArk использует контакты для добавления доверенных лиц"
      }
    }
  }
}
